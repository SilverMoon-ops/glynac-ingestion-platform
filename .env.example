# ============================================================================
# SALESFORCE BULK API v2
# ============================================================================
# Leave blank to use mock client; fill in real credentials to use actual Salesforce

# OAuth2 Client Credentials (from Salesforce Connected App)
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# Salesforce instance URL (e.g. https://mycompany.salesforce.com)
SALESFORCE_INSTANCE_URL=https://login.salesforce.com

# Force mock even if credentials are set (for local testing)
SALESFORCE_MOCK_ENABLED=true

# ============================================================================
# HMAC AUTHENTICATION
# ============================================================================
HMAC_SECRET=
# Password for the web console login (/ui). Required to use the UI.
UI_PASSWORD=
DATABASE_URL=sqlite:///./glynac.db
SIGNATURE_MAX_AGE_SECONDS=300

# ============================================================================
# OBJECT STORAGE: Local or MinIO
# ============================================================================
# "local" = ./data/objects (no Docker needed)
# "minio" = requires "docker compose up -d"
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./data/objects
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=glynac_admin
MINIO_SECRET_KEY=glynac_secret_key
MINIO_BUCKET=glynac
MINIO_SECURE=false

# ============================================================================
# CLICKHOUSE (optional)
# ============================================================================
# false = skip loading (only lands files in storage)
# true = actually load rows (requires "docker compose up -d")
CLICKHOUSE_ENABLED=false
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=glynac
CLICKHOUSE_PASSWORD=glynac_secret
CLICKHOUSE_DATABASE=glynac

# ============================================================================
# HUBSPOT (mock settings for demos)
# ============================================================================
HUBSPOT_MOCK_LATENCY_SECONDS=0.05
HUBSPOT_MOCK_TOTAL_RECORDS=47
HUBSPOT_MOCK_PAGE_SIZE=10

# ============================================================================
# dlt PIPELINE STATE
# ============================================================================
DLT_PIPELINES_DIR=./.dlt_pipelines

# ============================================================================
# SLACK (optional)
# ============================================================================
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Mock services: a real HTTP server standing in for Salesforce/HubSpot/Slack.
# Leave MOCK_SERVICES_URL empty to run it inside the API process on MOCK_SERVICES_PORT (one-command dev).
# docker-compose sets it to the separate mock-services container.
MOCK_SERVICES_URL=
MOCK_SERVICES_PORT=9000
SALESFORCE_RESULTS_PAGE_SIZE=1000
