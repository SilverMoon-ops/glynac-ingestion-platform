HMAC_SECRET=change-me-to-a-real-secret
DATABASE_URL=sqlite:///./glynac.db
SIGNATURE_MAX_AGE_SECONDS=300

# Object storage: "local" (writes under ./data/objects, no setup needed) or
# "minio" (requires `docker compose up -d`, see docker-compose.yml)
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./data/objects
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=glynac_admin
MINIO_SECRET_KEY=glynac_secret_key
MINIO_BUCKET=glynac
MINIO_SECURE=false

# ClickHouse: false = skip loading (still lands files in storage), true =
# actually load rows (requires `docker compose up -d`)
CLICKHOUSE_ENABLED=false
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=glynac
CLICKHOUSE_PASSWORD=glynac_secret
CLICKHOUSE_DATABASE=glynac

# Mock HubSpot speed — raise these for demos/videos so there's time to click
# Pause mid-run (e.g. 100 records x 0.5s/page = ~5s window)
HUBSPOT_MOCK_LATENCY_SECONDS=0.05
HUBSPOT_MOCK_TOTAL_RECORDS=47
HUBSPOT_MOCK_PAGE_SIZE=10
DLT_PIPELINES_DIR=./.dlt_pipelines
